void handleRoot() {                                 // These are frameworks for handling webpage requests. In the first case this method handles a request for the webpage /potplant.local/. We'll need to amend this to actually implent our homepage for the potplant
  server.send(200, "text/plain", "Hello world!");   // Send HTTP status 200 (Ok) and send some text to the browser/client
}

void handleNotFound(){                              // This method handles webpages of the form /potplant.local/xxx where xxx is some string not defined elsewhere
  server.send(404, "text/plain", "404: Not found"); // Send HTTP status 404 (Not Found) when there's no handler for the URI in the request
}




